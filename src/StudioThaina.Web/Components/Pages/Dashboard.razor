@page "/"
<PageTitle>Dashboard</PageTitle><h1>Dashboard</h1>
<div class="row g-3 mb-4"><div class="col"><div class="card p-3"><small>Faturamento</small><b>@resumo.Faturamento.ToString("C")</b></div></div><div class="col"><div class="card p-3"><small>Atendimentos</small><b>@resumo.QuantidadeAtendimentos</b></div></div><div class="col"><div class="card p-3"><small>Ticket médio</small><b>@resumo.TicketMedio.ToString("C")</b></div></div><div class="col"><div class="card p-3"><small>Mais realizado</small><b>@(resumo.ServicosMaisRealizados.FirstOrDefault()?.Servico??"—")</b></div></div></div>
<h2>Projeção de ganhos</h2><div class="row g-2"><div class="col"><InputDate class="form-control" @bind-Value="inicio" /></div><div class="col"><InputDate class="form-control" @bind-Value="fim" /></div><div class="col"><InputNumber class="form-control" @bind-Value="dias" /></div><div class="col"><button class="btn btn-primary" @onclick="Carregar">Calcular</button></div></div>
@if(projecao is not null){<div class="alert alert-info mt-3">Histórico: @projecao.FaturamentoHistorico.ToString("C") em @projecao.QuantidadeDiasAnalisados dias · Média: @projecao.MediaDiaria.ToString("C") · Projeção para @projecao.QuantidadeDiasProjetados dias: <b>@projecao.ValorProjetado.ToString("C")</b><br/><small>@projecao.Aviso</small></div>}
@code { DateTime inicio=DateTime.Today.AddDays(-30),fim=DateTime.Today;int dias=30;ResumoModel resumo=new();ProjecaoModel? projecao;protected override Task OnInitializedAsync()=>Carregar();async Task Carregar(){resumo=await Api.Resumo(inicio,fim);projecao=await Api.Projecao(inicio,fim,dias);} }
