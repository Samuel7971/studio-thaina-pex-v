@page "/agendamentos"
<h1>Agendamentos</h1><EditForm Model="modelo" OnValidSubmit="Criar"><div class="row g-2 mb-3"><div class="col"><InputSelect class="form-select" @bind-Value="modelo.ClienteId"><option value="0">Cliente</option>@foreach(var x in clientes.Where(x=>x.Ativo)){<option value="@x.Id">@x.Nome</option>}</InputSelect></div><div class="col"><InputSelect class="form-select" @bind-Value="modelo.ServicoId"><option value="0">Serviço</option>@foreach(var x in servicos.Where(x=>x.Ativo)){<option value="@x.Id">@x.Nome</option>}</InputSelect></div><div class="col"><InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="modelo.DataHora" /></div><div class="col"><InputNumber class="form-control" @bind-Value="modelo.ValorCobrado" /></div><div class="col-auto"><button class="btn btn-primary">Agendar</button></div></div></EditForm>
@if(!string.IsNullOrEmpty(erro)){<div class="alert alert-danger">@erro</div>}
<table class="table"><thead><tr><th>Data</th><th>Cliente</th><th>Serviço</th><th>Status</th><th>Alterar</th></tr></thead><tbody>@foreach(var x in itens){<tr><td>@x.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Cliente</td><td>@x.Servico</td><td>@x.Status</td><td><button class="btn btn-sm btn-success me-1" @onclick="()=>Status(x.Id,StatusAgendamento.Concluido)">Concluir</button><button class="btn btn-sm btn-danger" @onclick="()=>Status(x.Id,StatusAgendamento.Cancelado)">Cancelar</button></td></tr>}</tbody></table>
@code { List<AgendamentoModel> itens=[];List<ClienteModel> clientes=[];List<ServicoModel> servicos=[];AgendamentoModel modelo=new();string? erro;protected override async Task OnInitializedAsync(){clientes=await Api.Clientes();servicos=await Api.Servicos();await Carregar();}async Task Carregar()=>itens=await Api.Agendamentos();async Task Criar(){try{erro=null;await Api.Criar(modelo);modelo=new();await Carregar();}catch(HttpRequestException e){erro="Não foi possível agendar. Verifique se o horário está livre e os dados são válidos. "+e.Message;}}async Task Status(int id,StatusAgendamento s){await Api.Status(id,s);await Carregar();}}
