@page "/servicos"
<h1>Serviços</h1><EditForm Model="modelo" OnValidSubmit="Salvar"><div class="row g-2 mb-3"><div class="col"><InputText class="form-control" placeholder="Nome" @bind-Value="modelo.Nome" /></div><div class="col"><InputNumber class="form-control" placeholder="Minutos" @bind-Value="modelo.DuracaoMinutos" /></div><div class="col"><InputNumber class="form-control" placeholder="Valor" @bind-Value="modelo.Valor" /></div><div class="col-auto form-check"><InputCheckbox class="form-check-input" @bind-Value="modelo.Ativo"/> Ativo</div><div class="col-auto"><button class="btn btn-primary">Salvar</button></div></div></EditForm>
<table class="table"><thead><tr><th>Serviço</th><th>Duração</th><th>Valor</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var x in itens){<tr><td>@x.Nome</td><td>@x.DuracaoMinutos min</td><td>@x.Valor.ToString("C")</td><td>@(x.Ativo?"Ativo":"Inativo")</td><td><button class="btn btn-sm btn-outline-secondary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table>
@code { List<ServicoModel> itens=[];ServicoModel modelo=new();protected override async Task OnInitializedAsync()=>itens=await Api.Servicos();async Task Salvar(){await Api.Salvar(modelo);itens=await Api.Servicos();modelo=new();}void Editar(ServicoModel x)=>modelo=new(){Id=x.Id,Nome=x.Nome,Descricao=x.Descricao,DuracaoMinutos=x.DuracaoMinutos,Valor=x.Valor,Ativo=x.Ativo}; }
