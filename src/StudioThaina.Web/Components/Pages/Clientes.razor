@page "/clientes"
<h1>Clientes</h1><EditForm Model="modelo" OnValidSubmit="Salvar"><div class="row g-2 mb-3"><div class="col"><InputText class="form-control" placeholder="Nome" @bind-Value="modelo.Nome" /></div><div class="col"><InputText class="form-control" placeholder="Telefone" @bind-Value="modelo.Telefone" /></div><div class="col-auto form-check"><InputCheckbox class="form-check-input" @bind-Value="modelo.Ativo"/> Ativo</div><div class="col-auto"><button class="btn btn-primary">Salvar</button></div></div></EditForm>
<table class="table"><thead><tr><th>Nome</th><th>Telefone</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var x in itens){<tr><td>@x.Nome</td><td>@x.Telefone</td><td>@(x.Ativo?"Ativo":"Inativo")</td><td><button class="btn btn-sm btn-outline-secondary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table>
@code { List<ClienteModel> itens=[];ClienteModel modelo=new();protected override async Task OnInitializedAsync()=>itens=await Api.Clientes();async Task Salvar(){await Api.Salvar(modelo);itens=await Api.Clientes();modelo=new();}void Editar(ClienteModel x)=>modelo=new(){Id=x.Id,Nome=x.Nome,Telefone=x.Telefone,Observacao=x.Observacao,Ativo=x.Ativo}; }
